# ==================== App ====================
# Cổng HTTP của API server
PORT=5000
# development | production
NODE_ENV=development

# ==================== Database (MariaDB / MySQL) ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Lưu ý: tên database bị ép cứng thành "math_learning" trong src/config/env.js
# (bỏ qua DB_NAME/MYSQLDATABASE do môi trường như Railway tiêm vào).
# Bật SSL khi kết nối DB từ xa (Railway, PlanetScale...): true | false
DB_SSL=false

# ==================== Auth (JWT) ====================
# BẮT BUỘC đổi ở production — dùng chuỗi ngẫu nhiên đủ dài
# Gợi ý: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# ==================== AI (OpenRouter qua openai SDK) ====================
# Lấy key tại https://openrouter.ai/keys
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b:free
# Proxy đi ra internet. Cần khi chạy trong mạng công ty (vd http://proxy.fpt.vn:80),
# vì SDK openai không tự đọc biến proxy của shell. Để trống nếu nối thẳng được.
HTTPS_PROXY=

# ==================== CORS ====================
# Origin bổ sung ngoài danh sách mặc định trong index.js (localhost:5173, Vercel...)
# Phân cách bằng dấu phẩy, không có dấu / ở cuối
ALLOWED_ORIGINS=

# ==================== Email (tùy chọn — gửi thông báo cho người thân) ====================
# Bỏ trống SMTP_USER/SMTP_PASS để tắt tính năng gửi email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true khi dùng cổng 465 (SSL), false khi dùng 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
# Gmail: dùng App Password, không dùng mật khẩu tài khoản
SMTP_PASS=
# Địa chỉ hiển thị ở mục "From" — mặc định lấy SMTP_USER
SMTP_FROM=
