PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=math_learning
SECRET_KEY=your-secret-key-here
JWT_EXPIRES_IN=24h
OPENROUTER_API_KEY=your-openrouter-api-key

# Email (nodemailer) — dùng Gmail App Password (không phải mật khẩu Gmail thường)
# Hướng dẫn tạo App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Trường ABC <your-gmail@gmail.com>"
