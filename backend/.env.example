# ==================== App ====================
# Cổng HTTP của API server
PORT=5000
# development | production
NODE_ENV=development

# ==================== Database (MariaDB / MySQL) ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Lưu ý: tên database bị ép cứng thành "math_learning" trong src/config/env.js
# (bỏ qua DB_NAME/MYSQLDATABASE do môi trường như Railway tiêm vào).
# Bật SSL khi kết nối DB từ xa (Railway, PlanetScale...): true | false
DB_SSL=false

# ==================== Auth (JWT) ====================
# BẮT BUỘC đổi ở production — dùng chuỗi ngẫu nhiên đủ dài
# Gợi ý: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=change_me_to_a_long_random_string
JWT_EXPIRES_IN=24h

# ==================== AI (endpoint tương thích OpenAI, qua openai SDK) ====================
# Đổi nhà cung cấp = đổi biến trong .env, không phải sửa code.
#
# --- Cách 1: Gemini (đang dùng) ---
# Đặt GEMINI_API_KEY là chuyển hẳn sang Gemini, bộ OPENAI_* bên dưới bị bỏ qua
# (không cần xóa). Key lấy tại aistudio.google.com/apikey.
# Model trên bậc miễn phí — RPM đo thực tế (Google không công bố trong tài liệu,
# nhưng body lỗi 429 có ghi "limit: N"). Quota tính THEO PROJECT, không theo key,
# nên tạo key mới không được thêm lượt.
#   - gemini-3.5-flash-lite  ✅ 15 RPM  ← đang dùng, nhanh nhất trong nhóm đã thử
#   - gemini-3.1-flash-lite  ✅ 15 RPM
#   - gemini-3.6-flash       ⚠️  5 RPM  (chất lượng tương đương lite ở việc của dự án
#                                       nhưng chậm hơn ~3.7x và ít lượt hơn 3x)
#   - gemini-3.5-flash       ⚠️  5 RPM
#   - gemini-2.5-pro         ❌ quota bậc miễn phí = 0 → luôn trả 429
#   - gemini-2.5-flash       ❌ Google đã ngừng mở cho tài khoản mới → 404
#
# Lượt gọi bị tiêu ở đâu: chat giáo viên câu thường = 1 request, có dùng tool
# = 2–4 (1 lượt đầu + tối đa MAX_LOOPS vòng), chat học sinh = 1, sinh 50 câu hỏi
# = 5 (mỗi nhóm 10 câu 1 request). Gặp 429 thì tự chờ rồi gọi lại theo đúng
# khoảng Google báo — xem phần retry trong src/utils/llm.utils.js.
#
# Liệt kê model mà key của bạn dùng được:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Để trống — chỉ đổi khi Google thay đường dẫn lớp tương thích OpenAI
GEMINI_BASE_URL=
#
# --- Cách 2: nhà cung cấp tương thích OpenAI (dùng khi KHÔNG đặt GEMINI_API_KEY) ---
#   OpenRouter (mặc định)  BASE_URL=https://openrouter.ai/api/v1
#                          MODEL=openai/gpt-oss-120b:free   (key: openrouter.ai/keys)
#   Cerebras               BASE_URL=https://api.cerebras.ai/v1
#                          MODEL=gpt-oss-120b               (key: cloud.cerebras.ai)
#
# Để trống OPENAI_BASE_URL thì dùng OpenRouter.
OPENAI_BASE_URL=
# Lấy key tại trang tương ứng với BASE_URL ở trên
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b:free
# Proxy đi ra internet. Cần khi chạy trong mạng công ty (vd http://proxy.fpt.vn:80),
# vì SDK openai không tự đọc biến proxy của shell. Để trống nếu nối thẳng được.
HTTPS_PROXY=

# ==================== CORS ====================
# Origin bổ sung ngoài danh sách mặc định trong index.js (localhost:5173, Vercel...)
# Phân cách bằng dấu phẩy, không có dấu / ở cuối
ALLOWED_ORIGINS=

# ==================== Email (tùy chọn — gửi thông báo cho người thân) ====================
# Bỏ trống SMTP_USER/SMTP_PASS để tắt tính năng gửi email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true khi dùng cổng 465 (SSL), false khi dùng 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
# Gmail: dùng App Password, không dùng mật khẩu tài khoản
SMTP_PASS=
# Địa chỉ hiển thị ở mục "From" — mặc định lấy SMTP_USER
SMTP_FROM=
